		\fi%
		\insertsection%
		\ifthenelse{\equal{\thesubsection}{0}}{}{ - \insertsubsection%
			\ifthenelse{\equal{\thesubsubsection}{0}}{}{ - \insertsubsubsection}}
		\hfill%
