%-- graphic inclusion, overriding box sizes	------------------------------
%
% reducedgraphics[<include-Option>]{<graphic-File>}{<boxWidth>}{<boxHeight>}
\newcommand{\reducedgraphics}[4][]{%
\parbox[b][#4][t]{#3}{\includegraphics[#1]{#2}}}
%
% pictureobj{<obj>}{<x>,<y>}
\newcommand{\pictureobj}[2]{%
% \setlength{\unitlength}{1mm}%
\begin{picture}(0,0)(0,0)%	% offset:	+ move left	+ move down
	\put(#2){%			% direction:	+ move right	+ move top
		\makebox(0,0)[lb]{{#1}}}%
\end{picture}%
}
% picturegraphics[<include-Option>]{<graphic-File>}{<x>,<y>}
\newcommand{\picturegraphics}[3][]{%
\pictureobj{\includegraphics[#1]{#2}}{#3}%
}
% picturegraphicsmm[<include-Option>]{<graphic-File>}{<x>,<y>}{<video-File>}
\newcommand{\picturegraphicsmm}[4][]{%
\pictureobj{\movie[externalviewer]{\includegraphics[#1]{#2}}{#4}}{#3}%
}
%
% older version of picturegraphics with slightly different meaning and
% and ordering of the parameters, kept for backwards compatibility. 
%
% oldpicturegraphics{x}{y}{option}{file}
\newcommand{\oldpicturegraphics}[4]{%
% \setlength{\unitlength}{1mm}%
\begin{picture}(0,0)(0,0)%	% offset:	+ move left	+ move down
	\put(#1,#2){%		% direction:	+ move right	+ move top
		\makebox(0,0)[lb]{\includegraphics[#3]{#4}}}%
\end{picture}%
}
