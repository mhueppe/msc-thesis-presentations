\framebreak
  Grafikdateien, Objektpositionierung
  \begin{itemize}
  \item \verb+\reducedgraphics[+\angOp{options}\verb+]{+\angOp{file}%
	\verb+}{+\angOp{wd}\verb+}{+\angOp{ht}\verb+}+\\
	\texttt{includegraphics} in (künstlich verkleinerte) Box mit den
	Dimensionen \angOp{wd}$\times$\angOp{ht}
  \item \verb+\picturegraphics[+\angOp{options}\verb+]{+\angOp{file}%
	\verb+}{+\angOp{x}\verb+,+\angOp{y}\verb+}+\\
	\texttt{includegraphics} in \texttt{picture}-Umgebung der Größe
	0$\times$0
	\begin{itemize}
	\item \angOp{x} ist der horizontale Offset (nach rechts)
	\item \angOp{y} ist der \txtbox{horizontale}{vertikale}
		Offset (nach oben)
	\item Offsets werden ohne Einheit $[mm]$ angegeben
	\item \angOp{options} Optionen von \texttt{includegraphics}
	\item \angOp{file} Dateiname
	\end{itemize}
  \item \verb+\picturegraphicsmm[+\angOp{options}\verb+]{+\angOp{file}%
	\verb+}{+\angOp{x}\verb+,+\angOp{y}\verb+}{+\angOp{media}\verb+}+\\
	\texttt{picturegraphics} mit Multimedia Start:
	{\small\verb+\movie{+\angOp{media}\verb+}+}
  \item \verb+\pictureobj{+\angOp{object}%
        \verb+}{+\angOp{x}\verb+,+\angOp{y}\verb+}+\\
	freie Positionierung von \angOp{object} auf der Seite,
	z.B. für Text
%  \item \verb+\oldpicturegraphics{+\angOp{x}\verb+}{+\angOp{y}%
%	\verb+}{+\angOp{options}\verb+}{+\angOp{file}\verb+}+\\
%	Kompatibilitätsversion zu \texttt{picturegraphics}
  \end{itemize}
